# Niffler environment — reference copy of every NIF_* variable.
#
# Copy to `.env` (repo root, gitignored) and uncomment what you want to
# change. Everything below is OPTIONAL: each line shows the built-in default
# as the commented value, so an uncommented line with the same value changes
# nothing.
#
# Loading rules (identical in the Nim, Go and TypeScript SDKs):
#   - `.env` is read from the current directory and from $NIF_ROOT;
#   - the existing shell environment ALWAYS wins over `.env` — so
#     `NIF_OPENAI_API_KEY=other ./var/bin/niffler` overrides this file, and
#     you must `unset` a var for the file value to apply.
#
# All Niffler variables carry the NIF_ prefix so they never collide with the
# bare conventions other tools use (NATS_URL, OPENAI_API_KEY). Non-NIF_ vars
# (DISCORD_TOKEN, SYNTHETIC_API_KEY, ...) are read only by the specific
# components that document them.
#
# Full prose for each subsystem lives in docs/MANUAL.md.

# ---------------------------------------------------------------------------
# Boot & bus — set these before launch; they decide WHICH harness you attach
# to, so they are not runtime-changeable.
# ---------------------------------------------------------------------------

# The harness root (repo). Core derives it from its binary location when
# unset, and exports it to every child; components use it to find the SDK,
# var/, .env. Every component runs with cwd = NIF_ROOT.
#NIF_ROOT=

# Bus address. Two distinct meanings:
#   - set in the ENVIRONMENT (tests, bench, scripts): attach-only — core uses
#     exactly that bus;
#   - set in .env: the clone's HOME bus (default nats://127.0.0.1:4222) —
#     claimed when free, attached to only when the answering core serves this
#     root, yielded loudly to a foreign core, and written to var/nats-url.
#NIF_NATS_URL=

# 1 forces an isolated core-owned bus on a random port — never 4222, never
# attaches (dev clones and tests). An explicit NIF_NATS_URL wins over this.
#NIF_NATS_SPAWN=1

# Set by an SDK's ensureHarness when a UI had to spawn core: that core exits
# when the last interactive client departs. Leave unset interactively.
#NIF_AUTOSTART=1

# Seconds after the last interactive departure before an autostarted core
# exits.
#NIF_AUTOSTART_IDLE_S=10

# Seconds an autostarted core waits for its first interactive client before
# giving up.
#NIF_AUTOSTART_BOOT_S=60

# 0 makes ensureHarness skip attaching and always spawn a core (tests).
#NIF_ENSURE_ATTACH=1

# Store engine selected at boot: sqlite (default → var/bin/store-sqlite),
# barrel (→ var/bin/store), tidb (→ var/bin/store-tidb); anything else
# refuses to boot. All engines register as component `store` with identical
# tools. An un-migrated barrel makes core refuse to boot with the
# niffler-store-migrate instructions — barrel here is the escape hatch.
#NIF_STORE_BACKEND=sqlite

# TiDB/MySQL DSN for the tidb store engine, e.g.
# root@tcp(127.0.0.1:4000)/niffler (docker single-node:
# docker run -p 4000:4000 pingcap/tidb). Required for that engine — the
# component refuses to boot without it. Sessions are forced to UTC unless
# the DSN sets time_zone.
#NIF_STORE_TIDB_DSN=

# ---------------------------------------------------------------------------
# LLM connection — the default `chat` connection (see also the `provider`
# component, which supersedes these when it has an active provider).
# ---------------------------------------------------------------------------

# API key for the OpenAI-compatible LLM adapter. Required for any turn.
#NIF_OPENAI_API_KEY=

# OpenAI-compatible endpoint.
#NIF_OPENAI_BASE_URL=https://api.openai.com/v1

# Model name for the default connection.
#NIF_OPENAI_MODEL=deepseek-chat

# models.dev catalog provider id for the default connection; common endpoints
# are inferred when unset.
#NIF_OPENAI_PROVIDER=

# Explicit context window (tokens) the llm reports to core's context guard.
#NIF_OPENAI_CONTEXT=

# LLM retry policy (core/retry.nim). Retries apply to transient failures
# (429/5xx/overloaded/connection drop) with exponential backoff; each retry
# announces ev.session.retry. Auth/quota/bad-request errors always fail fast.

# Additional attempts for the general/no-hint case.
#NIF_LLM_MAX_RETRIES=2

# Additional attempts when a streamed response drops mid-flight (may have
# billed output, so budgeted separately).
#NIF_LLM_MAX_STREAM_RETRIES=2

# Additional attempts for connect/dial failures.
#NIF_LLM_MAX_CONNECT_RETRIES=2

# Upper bound (ms) honored from a server `retry-after` hint; a hinted wait
# longer than this is clamped.
#NIF_LLM_RETRY_AFTER_CAP_MS=3600000

# Ceiling (ms) for one llm chat completion. Slow reasoning models can exceed
# the default on a single response.
#NIF_LLM_TIMEOUT_MS=300000

# JSON object of named providers the chat tool's `provider` arg resolves:
# {"nickname": {"baseUrl","apiKey","model","context","catalog"}}. Superseded
# when the provider component has an active provider.
#NIF_LLM_PROVIDERS={}

# ---------------------------------------------------------------------------
# Model catalog (`models` component) — models.dev-compatible.
# ---------------------------------------------------------------------------

# Catalog base URL or JSON endpoint.
#NIF_MODELS_URL=https://models.dev/api.json

# Pinned local baseline catalog; useful offline/testing.
#NIF_MODELS_PATH=

# Local JSON Merge Patch applied after every plugin source.
#NIF_MODELS_OVERRIDE=

# 1 disables remote catalog refresh.
#NIF_MODELS_OFFLINE=1

# Catalog and source-patch cache directory.
#NIF_MODELS_CACHE_DIR=$NIF_ROOT/var/models

# Minimum age before refetching the baseline.
#NIF_MODELS_CACHE_TTL=5m

# Background refresh interval; 0 disables.
#NIF_MODELS_REFRESH_INTERVAL=1h

# ---------------------------------------------------------------------------
# Context & compaction — admission guard and the summarization proposal tool.
# ---------------------------------------------------------------------------

# Output tokens held back by context admission; 0 disables the reserve.
#NIF_CTX_RESERVE=16384

# Hard LLM-round ceiling per turn; a per-session maxRounds can narrow it.
#NIF_MAX_TURN_ROUNDS=1000

# Contract-v1 proposal tool selected by the runner; empty disables
# summarization (prune/trim/error admission stay active).
#NIF_COMPACTION_TOOL=compaction_propose

# Whole proposal-call deadline (ms, minimum 5000).
#NIF_COMPACTION_TIMEOUT_MS=90000

# Auxiliary summarization call budget granted to one compaction attempt; a
# candidate exceeding it is rejected as invalid.
#NIF_COMPACTION_MAX_LLM_CALLS=4

# Per-call checkpoint output cap (tokens).
#NIF_COMPACTION_MAX_SUMMARY_TOKENS=2048

# Estimated-token cap on a conversation's direct toolset for
# invoke {sticky: true} promotion; a promotion that would exceed it is
# deferred and reported in the tool result.
#NIF_MAX_DIRECT_TOKENS=4000

# ---------------------------------------------------------------------------
# Approvals & sessions — the human gate and conversation lifecycle.
# ---------------------------------------------------------------------------

# 1 bypasses the approval gate entirely. HEADLESS AUTOMATION ONLY (bench,
# CI) — never set it in a session you care about. The bench harness sets it
# programmatically on its isolated private root; it must not live in a dev
# root's .env.
#NIF_AUTO_APPROVE=1

# 1 answers every /limit keep-going question with yes (implies
# NIF_AUTO_CONTINUE). Headless automation only.
#NIF_AUTO_CONTINUE=1

# Named tool profile for NEW conversations when the session call carries no
# profile argument. Existing conversations keep their frozen toolset.
#NIF_PROFILE=

# A session runner with no session call for this long (seconds) retires; the
# next call spawns a fresh one.
#NIF_RUNNER_IDLE_S=600

# Default model tiers for fresh subagents requesting modelTier (weak /
# medium / strong). Exact model ids; a child tier is clamped to the parent's
# configured tier. Unset tiers make that tier unavailable.
#NIF_AGENT_MODEL_WEAK=
#NIF_AGENT_MODEL_MEDIUM=
#NIF_AGENT_MODEL_STRONG=

# Tier ceiling when the parent's exact model is not in the configured ladder
# (weak, medium, or strong).
#NIF_AGENT_DEFAULT_TIER=strong

# Maximum delegation depth for agent_spawn children (0 forbids delegation
# entirely; spawn tools stay visible at the cap).
#NIF_AGENT_MAX_DEPTH=1

# ---------------------------------------------------------------------------
# File tools
# ---------------------------------------------------------------------------

# Cap (bytes) for the write tool's whole-file payload.
#NIF_WRITE_MAX_BYTES=900000

# Whole-read line threshold above which read returns a language-server
# symbol outline instead of the raw window; 0 disables the outline.
#NIF_READ_OUTLINE_LINES=1000

# ---------------------------------------------------------------------------
# repo_map (repomap component)
# ---------------------------------------------------------------------------

# 1 opts into the workspace-open auto-append (the map is injected into every
# new conversation once). OFF by default: the A/B showed +41% tokens for no
# accuracy gain on full30 and 8/10 vs 9/10 at 3.7x tokens on Multi10 —
# see bench/reports/repomap-ab-{full30,multi10}.md. The repo_map tool itself
# is always available regardless of this flag.
#NIF_REPOMAP_AUTOAPPEND=1

# Gates for that append (docs/research/REPOMAP-GATES.md): a workspace below
# the census floor is never mapped, and a map below any content gate is a
# stub and is withheld.
#NIF_REPOMAP_MIN_CENSUS=50
#NIF_REPOMAP_MIN_BYTES=800
#NIF_REPOMAP_MIN_SYMBOLS=25
#NIF_REPOMAP_MIN_FILES=5

# ---------------------------------------------------------------------------
# fetch (web)
# ---------------------------------------------------------------------------

# Directory for large fetch results and temporary extraction files.
#NIF_FETCH_DIR=$NIF_ROOT/var/fetch

# 1 allows fetch to contact loopback/private/link-local destinations; use
# only for trusted local development services.
#NIF_FETCH_ALLOW_PRIVATE=1

# Trafilatura executable path/name; `off` disables external extraction.
#NIF_TRAFILATURA=trafilatura

# ---------------------------------------------------------------------------
# Language servers (lsp)
# ---------------------------------------------------------------------------

# Absolute path of the language-server user registry (servers.json).
#NIF_LSP_REGISTRY=$XDG_CONFIG_HOME/niffler-lsp/servers.json

# Extra directories searched for server binaries beyond PATH (colon- or
# space-separated; ~ expanded).
#NIF_LSP_BIN_DIRS=

# Warmup budgets (ev.workspace.opened): heavy servers index the whole
# workspace, cheap ones (bash-language-server) index nothing and never
# displace a heavy pick.
#NIF_LSP_WARM_MAX=2
#NIF_LSP_WARM_CHEAP=1
#NIF_LSP_WARM_TOTAL=4

# ---------------------------------------------------------------------------
# External MCP servers (mcp)
# ---------------------------------------------------------------------------

# Registry base URL for the server catalog (air-gapped/proxied setups).
#NIF_MCP_REGISTRY_URL=

# Cached-tool count at which a configured `expose: direct` MCP server stops
# publishing directly and defers to progressive discovery.
#NIF_MCP_DIRECT_THRESHOLD=10

# Probe timeout (ms) for server catalog/health checks and mcp_add validation
# (npx/uvx first-run downloads may need more than the default).
#NIF_MCP_PROBE_TIMEOUT_MS=30000

# Explicit path of the mcp-bridge binary (default <root>/var/bin/mcp-bridge).
#NIF_MCP_BRIDGE_BIN=$NIF_ROOT/var/bin/mcp-bridge

# ---------------------------------------------------------------------------
# Background processes (processes)
# ---------------------------------------------------------------------------

# Spool size (bytes) before a background process's output file is truncated
# to its tail on the next poll.
#NIF_PROCESSES_SPOOL_CAP=33554432

# Maximum new bytes one process_poll returns per stream (kept below the spool
# cap so a burst is always split).
#NIF_PROCESSES_POLL_CHUNK=65536

# ---------------------------------------------------------------------------
# Observation (observe) — bounded live inspection
# ---------------------------------------------------------------------------

# Messages retained in observe's global ring.
#NIF_OBSERVE_RING=2000

# Approximate wire bytes retained in the global ring.
#NIF_OBSERVE_RING_BYTES=16777216

# Maximum retained bytes per observed message.
#NIF_OBSERVE_ENTRY_BYTES=65536

# Active + stopped probes retained at once.
#NIF_OBSERVE_MAX_PROBES=32

# Retained bytes per probe.
#NIF_OBSERVE_PROBE_BYTES=2097152

# Confined directory for observe_dump output.
#NIF_OBSERVE_CAPTURE_DIR=$NIF_ROOT/var/captures

# Aggregate generated-capture quota (bytes); oldest files are pruned.
#NIF_OBSERVE_CAPTURE_BYTES=67108864

# Explicit nats-server HTTP monitoring endpoint for an external/reused bus
# (normally discovered via the core discovery file).
#NIF_OBSERVE_MONITOR_URL=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# SDK structured-log publication threshold (debug, info, warn, error).
#NIF_LOG_LEVEL=info

# logfile component — rotating JSONL persistence of bus traffic:
#NIF_LOGFILE_DIR=$NIF_ROOT/var/logs
#NIF_LOGFILE_SUBJECTS=ev.log.>
#NIF_LOGFILE_MAX_BYTES=10485760
#NIF_LOGFILE_KEEP=5
#NIF_LOGFILE_MAX_FILES=64
#NIF_LOGFILE_SCAN_BYTES=16777216
#NIF_LOGFILE_DIRECTORY_ENTRIES=10000

# Core's child-log retention in var/logs:
#NIF_LOG_MAX_MB=200
#NIF_LOG_RETENTION_DAYS=7

# ---------------------------------------------------------------------------
# Hooks (hooks component) — observe-only automation, read at boot; a config
# change is core.kill + core.spawn (the harness's hot-change idiom).
# ---------------------------------------------------------------------------

# Comma-separated subjects to watch; trailing '>' wildcards work.
#NIF_HOOKS_EVENTS=ev.session.turn

# One command per subject — dots and '>' map to underscores in the variable
# name (ev.session.turn → NIF_HOOKS_EV_SESSION_TURN, ev.log.> →
# NIF_HOOKS_EV_LOG_). The decoded event payload is piped to the command's
# stdin as pretty JSON.
#NIF_HOOKS_EV_SESSION_TURN=

# Per-hook timeout (ms); max 60000.
#NIF_HOOKS_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Ops — mirrors and registries (regional/proxied setups)
# ---------------------------------------------------------------------------

# Host prefix replacing https://github.com when the plugins component clones
# packages (API/search endpoints stay on GitHub).
#NIF_GIT_MIRROR=

# npm registry for builder ts-component installs.
#NIF_NPM_REGISTRY=

# Host for the local OAuth callback listener (ports stay fixed at
# 1455/53692).
#NIF_OAUTH_CALLBACK_HOST=127.0.0.1

# Explicit location of the skills component's bundled tree, replacing
# <repo>/skills and its $NIF_ROOT/skills fallback (deployments shipping
# var/bin without the repo checkout).
#NIF_SKILLS_BUNDLED_DIR=

# ---------------------------------------------------------------------------
# Test & bench only — leave unset outside test/bench invocations. These are
# read by tests/ and bench/ code, never by a production component.
# ---------------------------------------------------------------------------
#NIF_TEST_INSTALL=1        # make test-*: run the real plugin install from GitHub
#NIF_TEST_NETWORK=1        # make test-*: real network for search/build tests
#NIF_STORE_BIN=            # store engine binary a test should drive
#NIF_REPO_ROOT=            # repo under test when it differs from NIF_ROOT
#NIF_SMOKE_MODEL=          # smoke test model override
#NIF_SMOKE_CTX=            # smoke test context override
#NIF_SMOKE_KEEP=           # keep smoke test roots
#NIF_CONF_KEEP=            # keep test config dirs
#NIF_MOCK_ROUNDS=          # mock LLM: scripted bash rounds (tests/mock_llm)
#NIF_MOCK_SCENARIO=        # mock LLM: scenario script
#NIF_MOCK_TOOLCMD=         # mock LLM: tool command to run
#NIF_MOCK_CTX=             # mock LLM: fake context size
#NIF_MOCK_FAIL_FIRST=      # mock LLM: fail the first N calls
#NIF_MOCK_HIDE_CTX=        # mock LLM: hide ctx from the transcript
#NIF_MOCK_LOG=             # mock LLM: log file
#NIF_MOCK_HISTORY_MARKER=  # mock LLM: history marker injection
#NIF_MOCK_COMPACTION_SLEEP_MS=  # mock LLM: compaction latency
#NIF_FIXTURE_LLM_CALLS=    # fixture: expected LLM call count
#NIF_FIXTURE_CHECKPOINT_ONLY=   # fixture: checkpoint-only mode
#NIF_SWEBENCH_PYTHON=      # swe-bench python interpreter
#NIF_SWEBENCH_TEST_TIMEOUT=     # swe-bench per-test timeout
#NIF_SWEBENCH_HARNESS_TIMEOUT_MS=  # swe-bench harness timeout
#NIF_DEEPSWE_HARNESS_TIMEOUT_MS=   # deepswe harness timeout
